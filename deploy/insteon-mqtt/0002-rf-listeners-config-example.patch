+++ b/config-example.yaml
@@ -231,8 +231,8 @@ mqtt:
   # where "frame" is the message as the modem would have reported it.
   #
   # A message is only considered if the modem did not read it, has not
-  # since read a later message from the same device, and (for a group
-  # broadcast) holds a link for that group.  Tiers:  battery = broadcasts
