From 859f8b3de83c441186d9360868caf07f137dbbda Mon Sep 17 00:00:00 2001
From: Josh Lukens <jlukens@botch.com>
Date: Sun, 15 Nov 2026 09:48:05 -0500
Subject: [PATCH] Add optional raw message topics for external RF receivers

A PLM hears only what reaches its own antenna, and passes up only the
group broadcasts it holds a link for. Battery devices (leak, door,
remotes) are RF-only and can't be polled, so a message the modem misses
from one of them is simply lost. Additional receive-only RF listeners
placed elsewhere in the house can hear those messages; this adds the
seam to hand them over without adding a second transmitter.

Two MQTT topics under a new optional `mqtt.raw` config section:

- publish_topic (default insteon/raw/rx): every frame read from the
  modem as JSON, before the duplicate check, with a "dup" flag. This
  is what a listener needs to know what the modem already heard.
- inject_topic (default insteon/raw/inject): complete 0x50/0x51
  inbound frames, parsed by the new Protocol.inject() and handed to the
  normal duplicate check and handler dispatch. Anything else (modem
  commands, replies, malformed or wrong-length frames) is rejected.

Both are off by default. Without a `raw` section no Raw object is
created and no topic is subscribed, so nothing changes for existing
installs. Protocol gains one signal, emitted per frame read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0157MSwwBp84p98F4Aq9dGR3
---
 insteon_mqtt/Protocol.py             |  75 ++++++++++-
 insteon_mqtt/data/config-schema.yaml |  12 ++
 insteon_mqtt/mqtt/Mqtt.py            |  18 +++
 insteon_mqtt/mqtt/Raw.py             | 183 +++++++++++++++++++++++++++
 4 files changed, 287 insertions(+), 1 deletion(-)
 create mode 100644 insteon_mqtt/mqtt/Raw.py

diff --git a/insteon_mqtt/Protocol.py b/insteon_mqtt/Protocol.py
index 01a9402..bab0ac4 100644
--- a/insteon_mqtt/Protocol.py
+++ b/insteon_mqtt/Protocol.py
@@ -94,6 +94,12 @@ class Protocol:
         # been removed from the _write_queue
         self.signal_msg_finished = Signal()  # (Message)
 
+        # Emitted for every inbound Insteon message read from the modem, with
+        # the raw frame bytes and whether it was judged a duplicate.  This is
+        # the ground truth for "what did the modem actually hear", which an
+        # external receiver needs in order to know what it should inject.
+        self.signal_raw_read = Signal()  # (bytes, bool)
+
         # Inbound message buffer.
         self._buf = bytearray()
 
@@ -271,6 +277,70 @@ class Protocol:
                     return True
         return False
 
+    #-----------------------------------------------------------------------
+    def inject(self, raw):
+        """Process an inbound Insteon message that did not come from the modem.
+
+        A PLM hears only what reaches its single antenna, and passes up only
+        the group broadcasts it holds an ALDB link for.  Additional receivers
+        placed elsewhere can hear messages the modem missed; handing them over
+        here makes the modem effectively more sensitive without introducing a
+        second transmitter.
+
+        The bytes must be a complete inbound message frame exactly as the
+        modem would have produced it (0x02 0x50 for standard, 0x02 0x51 for
+        extended).  Nothing else is accepted: an injected frame is not allowed
+        to reconfigure the modem or fake a reply to an outbound command at the
+        link level.
+
+        This deliberately does **not** feed self._buf.  That buffer is filled
+        by the serial link and may hold a partially received frame; appending
+        to it would interleave the two streams and corrupt both.  Instead the
+        frame is parsed on its own and handed to the same duplicate check and
+        handler dispatch that _data_read() uses, so an injected copy of a
+        message the modem also heard is dropped exactly like a mesh repeat.
+
+        Args:
+          raw (bytes):  A complete 0x50 or 0x51 modem frame.
+
+        Returns:
+          bool:  True if the message was processed, False if it was rejected
+          as malformed or dropped as a duplicate.
+        """
+        buf = bytes(raw)
+        if len(buf) < 2 or buf[0] != 0x02:
+            LOG.warning("Injected frame does not start with 0x02: %s",
+                        buf.hex())
+            return False
+
+        msg_type = buf[1]
+        if msg_type not in (Msg.InpStandard.msg_code,
+                            Msg.InpExtended.msg_code):
+            LOG.warning("Injected message code %#04x is not an inbound "
+                        "Insteon message", msg_type)
+            return False
+
+        msg_class = Msg.types[msg_type]
+        if len(buf) != msg_class.msg_size(buf):
+            LOG.warning("Injected %#04x frame is %d bytes, needs %d", msg_type,
+                        len(buf), msg_class.msg_size(buf))
+            return False
+
+        try:
+            msg = msg_class.from_bytes(buf)
+        except Exception:
+            LOG.exception("Cannot parse injected message bytes %s", buf.hex())
+            return False
+
+        LOG.info("Injected %#04x: %s", msg_type, msg)
+
+        if self._is_duplicate(msg):
+            LOG.info("Ignored duplicate injected %s", msg)
+            return False
+
+        self._process_msg(msg)
+        return True
+
     #-----------------------------------------------------------------------
     def _poll(self, t):
         """Periodic polling function.
@@ -375,10 +445,13 @@ class Protocol:
                 self._buf = self._buf[1:]
                 continue
 
+            raw = bytes(self._buf[:msg_size])
             self._buf = self._buf[msg_size:]
             LOG.info("Read %#04x: %s", msg_type, msg)
 
-            if self._is_duplicate(msg):
+            duplicate = self._is_duplicate(msg)
+            self.signal_raw_read.emit(raw, duplicate)
+            if duplicate:
                 LOG.info("Ignored duplicate %s", msg)
             else:
                 # And try to process the message using the handlers.
