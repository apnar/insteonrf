# insteon-rf RF listeners for the house: the rfcat dongle pod, the mesh pod
# and the RTL-SDR V3 pod all run this one image.
#
# Built locally (buildah bud → ctr image import) so restarts do not re-download
# anything and the pods work without internet:
#   rsync -a --delete --exclude .git --exclude .venv --exclude '*.pyc' \
#         /root/insteon/insteonrf/ /nvme/k8s/insteonrf-config/build/src/
#   cd /nvme/k8s/insteonrf-config/build && buildah bud -t insteonrf:local .
#   rm -f /var/tmp/insteonrf.tar   # docker-archive will not overwrite one
#   buildah push localhost/insteonrf:local docker-archive:/var/tmp/insteonrf.tar:localhost/insteonrf:local
#   microk8s ctr image import /var/tmp/insteonrf.tar
#
# libusb-1.0-0 is the part that is easy to miss: pyusb needs the shared library,
# and python:*-slim does not ship it, so rflib cannot see the dongle without it.

# --- the listener ----------------------------------------------------------
# librtlsdr comes from Debian (rtl-sdr 2.0.2 in trixie), not a source build.
# Until 2026-10 this stage built the rtlsdrblog fork from git HEAD for the
# V4's R828D front end, with DETACH_KERNEL_DRIVER=ON because the kernel DVB
# driver claims the device on sight. Osmocom 2.0.2 has both: its library
# carries the "Blog V4" / R828D support and detaches the kernel driver
# itself (checked in the built library, 2026-10-03). So the stock package
# drives the V3s in use now *and* a V4, and the build is reproducible
# instead of following someone else's HEAD. It also brings rtl_test and
# rtl_eeprom (`rtl_test -d 99` lists serials without opening anything).
FROM python:3.13-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libusb-1.0-0 git rtl-sdr \
 && rm -rf /var/lib/apt/lists/* \
 && rtl_sdr -h 2>&1 | head -1

COPY src /src
RUN pip install --no-cache-dir /src "/src[mqtt,radio]" \
 && pip install --no-cache-dir "git+https://github.com/atlas0fd00m/rfcat" \
 && python -c "import insteonrf, rflib, usb.core, numpy, paho.mqtt.client; print(insteonrf.__version__)"

WORKDIR /config
ENTRYPOINT ["insteon-rf"]
